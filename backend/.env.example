# App
APP_NAME=AdVault
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite+aiosqlite:///./advault.db

# Backblaze B2 (required)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=advault-media
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_PUBLIC_URL_BASE=
B2_PREFIX=advault
B2_PRESIGN_TTL_SECONDS=900
B2_OBJECT_LOCK_DAYS=30

# --- Free path (official sample README) ---
# NVIDIA NIM: free API, no card — image · video · TTS  ← recommended
# https://build.nvidia.com/
NVIDIA_API_KEY=

# Optional free TTS tiers
# https://elevenlabs.io/ → ELEVENLABS_API_KEY
# https://www.lmnt.com/ → LMNT_API_KEY
ELEVENLABS_API_KEY=
LMNT_API_KEY=

# Paid / credit-based (only if you have balance)
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
GMI_API_KEY=
GMICLOUD_API_KEY=

# Pin vendors (optional). Empty = auto free-first (nvidia → …)
IMAGE_VENDOR=decart
VIDEO_VENDOR=local
# Magpie TTS probes DEAD on free NIM genai — use local edge-tts by default
TTS_VENDOR=edge
INCLUDE_MUSIC=false
# MUSIC_VENDOR=  # skip music unless Replicate/GMI has credits

# Model defaults (Decart image + local Ken Burns video; NVIDIA Cosmos DEAD)
IMAGE_MODEL=lucy-image-2
VIDEO_MODEL=kenburns
VIDEO_FALLBACK_MODELS=
VOICE_MODEL=en-US-JennyNeural
MUSIC_MODEL=meta/musicgen

OUTPUT_DIR=./data/output
FFMPEG_PATH=ffmpeg
DEMO_MODE=false

# --- Observability -----------------------------------------------------------
# JSON logs carry a request_id you can correlate with the X-Request-ID header.
LOG_LEVEL=INFO
LOG_JSON=true

# --- Abuse protection --------------------------------------------------------
# In-process limiter. Move to Redis before running more than one replica.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WRITE_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_RUNS_PER_CAMPAIGN=2
